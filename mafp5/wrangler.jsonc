{
  "name": "monitoring-availability-fasilitas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mafp5-db",
      "database_id": "8ba02017-2d9c-41e4-9b91-65e272d605bc",
      "migrations_dir": "prisma/migrations"
    }
  ]
}
