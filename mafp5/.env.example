# Salin file ini menjadi .env lalu sesuaikan nilainya.
#
# CATATAN: Di produksi (Cloudflare Workers) aplikasi TIDAK memakai DATABASE_URL.
# Database diakses lewat binding Cloudflare D1 "DB" (lihat wrangler.jsonc), dan
# AUTH_SECRET diset sebagai Worker secret. Variabel di bawah ini hanya dipakai
# oleh perkakas dev lokal (prisma db push / db seed yang membuat prisma/dev.db,
# sumber data untuk scripts/gen-d1-seed.sh) dan oleh `next dev`.

# SQLite lokal untuk perkakas Prisma (bukan dipakai runtime aplikasi).
DATABASE_URL="file:./dev.db"

# Secret untuk menandatangani sesi (JWT). WAJIB diganti di produksi dengan
# string acak yang panjang, mis. hasil: openssl rand -base64 48
# Untuk preview/produksi Cloudflare, set di .dev.vars (lokal) dan sebagai
# Worker secret (produksi), bukan di sini.
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
