# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Database. Dev memakai SQLite (zero-config). Untuk produksi, ubah provider di
# prisma/schema.prisma menjadi "postgresql" dan isi DATABASE_URL Postgres Anda.
DATABASE_URL="file:./dev.db"

# Secret untuk menandatangani sesi (JWT). WAJIB diganti di produksi dengan
# string acak yang panjang, mis. hasil: openssl rand -base64 48
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
